<?xml version="1.0" encoding="UTF-8"?>
<tt xml:lang="ja" xmlns="http://www.w3.org/ns/ttml"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter"
    xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata"
    ttp:contentProfiles="http://www.w3.org/ns/ttml/profile/imsc1.1/text">
  <head>
    <metadata>
      <ttm:desc>rb/rt in vertical text with rubyPosition before, after and outside</ttm:desc>
    </metadata>
    <layout>
      <region xml:id="r1" tts:fontSize="200%" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" tts:textAlign="center" tts:writingMode="tbrl"/>
    </layout>
  </head>
  <body>
    <div region="r1">
      <p begin="0s" end="2s">
        <span tts:ruby="container">
          <span tts:ruby="base">日本語</span>
          <span tts:ruby="text" tts:rubyPosition="before">にほんご</span>
        </span>の字幕
      </p>
      <p begin="2s" end="4s">
        <span tts:ruby="container">
          <span tts:ruby="base">日本語</span>
          <span tts:ruby="text" tts:rubyPosition="after">にほんご</span>
        </span>の字幕
      </p>
      <p begin="4s" end="6s">
        <span tts:ruby="container">
          <span tts:ruby="base">日本語</span>
          <span tts:ruby="text" tts:rubyPosition="outside">にほんご</span>
        </span>の字幕
      </p>
    </div>
  </body>
</tt>
