<?xml version="1.0" encoding="UTF-8"?>
<tt xml:lang="ja" xmlns="http://www.w3.org/ns/ttml"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter"
    xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata"
    ttp:contentProfiles="http://www.w3.org/ns/ttml/profile/imsc1.1/text">
  <head>
    <metadata>
      <ttm:desc>rbc with two rtc, one before and one after</ttm:desc>
    </metadata>
    <layout>
      <region xml:id="r1" tts:fontSize="200%" tts:origin="10% 10%" tts:extent="80% 80%" tts:displayAlign="after" tts:textAlign="center"/>
    </layout>
  </head>
  <body>
    <div region="r1">
      <p begin="0s" end="2s">
        <span tts:ruby="container">
          <span tts:ruby="baseContainer">
            <span tts:ruby="base">東</span>
            <span tts:ruby="base">京</span>
          </span>
          <span tts:ruby="textContainer" tts:rubyPosition="before">
            <span tts:ruby="text">とう</span>
            <span tts:ruby="text">きょう</span>
          </span>
          <span tts:ruby="textContainer" tts:rubyPosition="after">
            <span tts:ruby="text">ひがし</span>
            <span tts:ruby="text">みやこ</span>
          </span>
        </span>
      </p>
    </div>
  </body>
</tt>
