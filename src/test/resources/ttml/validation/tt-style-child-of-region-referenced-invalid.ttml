<tt xml:lang="en" xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling">
  <head>
    <layout>
      <region xml:id="r1" tts:extent="50% 50%">
        <style xml:id="s1" tts:color="red"/>
      </region>
    </layout>
  </head>
  <body region="r1">
    <div>
      <p style="s1">Hello</p>
    </div>
  </body>
</tt>
