<tt xml:lang="en"
    xmlns="http://www.w3.org/ns/ttml"
    xmlns:tts="http://www.w3.org/ns/ttml#styling">
  <head>
    <layout>
      <region xml:id="r1" tts:extent="50% 50%">
        <set begin="1s" end="2s" tts:opacity="0.5"/>
      </region>
    </layout>
  </head>
  <body region="r1">
    <div>
      <p>Hello</p>
    </div>
  </body>
</tt>
