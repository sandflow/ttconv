<?xml version="1.0" encoding="utf-8"?>
<!-- IMSC 1.1 Text Profile does not permit #embedded-audio -->
<tt xml:lang="en" xmlns="http://www.w3.org/ns/ttml"
    xmlns:ttp="http://www.w3.org/ns/ttml#parameter" ttp:profile="ttml2-transformation"
    xmlns:ttva="http://skynav.com/ns/ttv/annotations">
  <head>
    <resources>
      <data xml:id="data1" type="audio/mpeg" length="4">
        <chunk length="4">AAAA</chunk>
      </data>
    </resources>
  </head>
  <body>
    <div>
      <audio src="#data1"/>
    </div>
  </body>
</tt>
